{
	"name": "@indiegoweb/n8n-nodes-beehiiv",
	"version": "0.1.4",
	"description": "n8n node for Beehiiv API",
	"license": "MIT",
	"homepage": "https://github.com/whybothercoding/n8n-nodes-beehiiv",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Theo Slasha",
		"email": "contact@indiegoweb.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/whybothercoding/n8n-nodes-beehiiv.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc --noEmit",
		"test": "jest",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/BeehiivApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Beehiiv/Beehiiv.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.47.1",
		"@release-it/conventional-changelog": "^12.0.0",
		"@types/jest": "^30.0.0",
		"eslint": "9.32.0",
		"jest": "^30.5.1",
		"prettier": "3.9.6",
		"release-it": "^21.0.2",
		"ts-jest": "^29.4.12",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"allowScripts": {
		"isolated-vm@7.0.1": true,
		"isolated-vm@6.2.0": true,
		"cpu-features@0.0.10": true,
		"eslint-plugin-n8n-nodes-base@1.16.7": true,
		"fsevents@2.3.3": true,
		"fsevents@2.3.2": true,
		"ssh2@1.15.0": true,
		"@parcel/watcher@2.6.0": true,
		"unrs-resolver@1.12.2": true
	}
}
